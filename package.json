{
  "name": "motion-use",
  "version": "0.21.1",
  "description": "Directed local films with exact-time animation, authored shots and delivered-video verification. Built on HyperFrames.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "motion-use": "bin/motion-use.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "templates",
    "examples",
    "references",
    "SKILL.md",
    "LICENSE",
    "ASSETS.md",
    "docs",
    "scripts"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "node --check bin/motion-use.mjs && node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "harfbuzzjs": "1.6.2",
    "hyperframes": "0.8.123",
    "subset-font": "2.9.0"
  }
}
